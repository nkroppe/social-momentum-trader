# Production VPS environment template.
# Copy to .env on the server: cp .env.production.example .env
# NEVER commit .env.

LIVE=false
LIVE_ACK=

KILL_FILE=./control/KILL
PAPER_START_EQUITY=5000
LOOP_INTERVAL_SECONDS=60

# Postgres via docker-compose service name.
DATABASE_URL=postgresql+psycopg://smt:CHANGE_ME@postgres:5432/smt
POSTGRES_PASSWORD=CHANGE_ME

# --- Coinbase Advanced (leave empty during paper soak) ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PORTFOLIO_ID=

# --- Social ingest (required for production; disable mock in sources.yaml) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-momentum-trader/0.1 by yourusername
X_BEARER_TOKEN=
X_MONTHLY_BUDGET_USD=100
X_POST_READ_COST_USD=0.005
X_RECENT_COUNT_REQUEST_COST_USD=0.005
# Legacy migration-compatible read ceiling.
X_MONTHLY_READ_BUDGET=20000

# --- Sparse L3 LLM judge + weekly reflection (Cursor SDK) ---
# Create a user API key at Cursor Dashboard -> Integrations. SDK runs use the
# same request pools/pricing as Cursor and appear under the SDK usage tag.
# Never share this key or commit the populated .env.
CURSOR_API_KEY=

# --- Alerts (at least one channel required for soak) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
