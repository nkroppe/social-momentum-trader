# ------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# The paper loop runs with NONE of these set (uses mock data + SQLite).
# ------------------------------------------------------------------

# --- Global mode ---------------------------------------------------
# LIVE=false  -> paper trading only (default, safe)
# LIVE=true   -> real orders on Coinbase (requires all guardrails to pass)
LIVE=false
# Second safety latch: real orders only happen if this EXACTLY equals
# I_UNDERSTAND_LIVE_RISK *and* LIVE=true. Otherwise the app forces paper mode.
LIVE_ACK=

# Kill-file path. If this file exists, no new entries are opened and open
# positions are flattened on the next loop. Trip with: touch control/KILL
KILL_FILE=./control/KILL

# Paper-mode starting equity (used for sizing + loss-halt math).
PAPER_START_EQUITY=5000
# Main loop cadence (seconds) for exit checks.
LOOP_INTERVAL_SECONDS=60

# --- Storage -------------------------------------------------------
# Default is a local SQLite file so it runs with no Postgres.
# For the VPS, point at Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://smt:smt@postgres:5432/smt
DATABASE_URL=sqlite:///./data/smt.sqlite

# --- Coinbase Advanced Trade (TRADE-ONLY KEY) ----------------------
# Create with View + Trade permissions ONLY. Transfer MUST be disabled.
# The app refuses to start LIVE if the key reports can_transfer=true.
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Portfolio UUID of the ISOLATED bot portfolio (not your main funds).
COINBASE_PORTFOLIO_ID=

# --- Reddit (optional, for live ingest) ----------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-momentum-trader/0.1 by yourusername

# --- YouTube Data API (optional) -----------------------------------
YOUTUBE_API_KEY=

# --- X / Twitter (optional, budget-capped) -------------------------
X_BEARER_TOKEN=
X_MONTHLY_READ_BUDGET=50000

# --- Alerts --------------------------------------------------------
# Email (SMTP) for digests + warnings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Phone-reachable push for kill-switch-worthy events.
# ntfy: set a topic URL. Telegram: set bot token + chat id.
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
