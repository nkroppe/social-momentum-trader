# syntax=docker/dockerfile:1
FROM node:22-alpine AS frontend
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npx vite build --outDir /out --emptyOutDir

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    SMT_CONFIG_DIR=/app/config

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY --from=frontend /out ./src/smt/dashboard/static
RUN pip install --upgrade pip && pip install ".[live,dashboard]"
COPY config ./config

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/data /app/logs \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8080
CMD ["smt", "dashboard", "--host", "0.0.0.0", "--port", "8080"]
